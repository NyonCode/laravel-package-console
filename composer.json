{
    "name": "nyoncode/laravel-package-console",
    "description": "Artisan-like generators and scaffolding for developing Laravel 12 and 13 packages, with first-class laravel-package-toolkit support",
    "keywords": [
        "nyoncode",
        "laravel",
        "package",
        "console",
        "generator",
        "scaffold",
        "laravel-package-toolkit"
    ],
    "homepage": "https://github.com/NyonCode/laravel-package-console",
    "authors": [
        {
            "name": "Ondřej Nyklíček",
            "email": "ondrej@nyoncode.cz",
            "role": "Developer"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-readline": "*",
        "doctrine/inflector": "^2.0",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/finder": "^7.2|^8.0",
        "symfony/string": "^7.2|^8.0",
        "symfony/validator": "^7.2|^8.0",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8|^4.0"
    },
    "suggest": {
        "nyoncode/laravel-package-toolkit": "Generated resources are registered through its fluent Packager API"
    },
    "autoload": {
        "psr-4": {
            "NyonCode\\LaravelPackageConsole\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NyonCode\\LaravelPackageConsole\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest --exclude-group=integration",
        "test:integration": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv ANVIL_INTEGRATION=1",
            "vendor/bin/pest --group=integration"
        ],
        "pint": "vendor/bin/pint",
        "docs:commands": "php tests/Support/generate-command-reference.php"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "bin": [
        "bin/anvil"
    ]
}
